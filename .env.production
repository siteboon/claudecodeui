# CloudCLI FCC Server - Production Configuration
# Generated: 2026-08-26
# Version: 1.37.2

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (use 3001 for production)
SERVER_PORT=3001

# Frontend dev server port (used in development only)
VITE_PORT=5173

# Host binding (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
# For production, use 0.0.0.0 to accept external connections
HOST=0.0.0.0

# Node environment
NODE_ENV=production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to SQLite database file
# Production location: /var/lib/cloudcli/database.db
DATABASE_PATH=/var/lib/cloudcli/database.db

# Context window size (tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# =============================================================================
# SECURITY & CORS
# =============================================================================

# CORS origin - Set to your domain in production
# Examples:
#   CORS_ORIGIN=https://example.com
#   CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=https://your-domain.com

# Enable HTTPS only (set to true in production)
FORCE_HTTPS=false

# =============================================================================
# API PROVIDER CREDENTIALS (Optional)
# =============================================================================
# Set these if you want the server to have default provider access
# Users can also add their own credentials through the UI

# OpenRouter (multi-provider LLM support)
# Get key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Anthropic Claude API
# Get key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# Get key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Google Generative AI
# Get key from: https://makersuite.google.com/app/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=...

# Groq
# Get key from: https://console.groq.com/
# GROQ_API_KEY=...

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

# =============================================================================
# PERFORMANCE & LIMITS
# =============================================================================

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE=100

# Session timeout (in minutes, 0 = no timeout)
SESSION_TIMEOUT=1440

# Maximum concurrent sessions per user
MAX_SESSIONS_PER_USER=10

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# Before deploying to production:
#
# 1. Configure CORS_ORIGIN for your domain
# 2. Ensure DATABASE_PATH directory is writable
# 3. Set up SSL/TLS certificates (if FORCE_HTTPS=true)
# 4. Add API provider credentials for Claude/OpenAI/etc
# 5. Configure log rotation and monitoring
# 6. Set up database backups
# 7. Test health endpoint: curl http://localhost:3001/health
#
# Health Check Endpoint:
#   GET /health
#   Returns: {"status":"ok","timestamp":"...","version":"1.37.2"}
#
# =============================================================================
