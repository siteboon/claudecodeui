# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# FILE SYSTEM ACCESS
# =============================================================================

# Root directory that new workspaces must stay under (default: your home directory)
# WORKSPACES_ROOT=/home/user

# Comma-separated directories the UI and API may access (default: unset = no restriction).
# When set, only projects inside these directories are listed, the folder picker
# and file browser stay inside them, new workspaces can only be created inside
# them, and the project, file, Git, TaskMaster, worktree, session, command, MCP
# and skills APIs answer 403 for paths outside them. Symlinks are resolved, so a
# link inside an allowed directory cannot reach outside it. A leading ~ is
# expanded; use absolute paths (relative ones resolve against the server's
# working directory). The startup log warns about entries that do not exist.
#   - With WORKSPACES_ROOT set as well, a path must satisfy both.
#   - Without WORKSPACES_ROOT, ALLOWED_PATHS alone decides, so allowed
#     directories outside your home directory work.
#   - The Git panel and worktrees need the whole repository (its root and git
#     directory) inside an allowed directory. Worktrees are created next to the
#     repository (<repo>-worktrees/), so allow the parent directory if you use them.
#   - Conversations recorded in other directories are hidden too, and the file
#     viewer no longer opens background-task output under the temp directory
#     or ~/.claude/projects unless those are allowed.
#   - The agent API clones into ~/.claude/external-projects when no projectPath
#     is given; allow that directory if you use it.
# This is not a sandbox: the AI agents (Claude Code, Codex, Cursor, ...), chat and
# scheduled runs (their working directory is not checked), the TaskMaster CLI,
# plugin backends and the Shell tab run as your OS user and can still reach any
# file that user can.
# ALLOWED_PATHS=/home/user/proj1,/home/user/proj2

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000


