{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist/**",
    "dist-server/**",
    "node_modules/**",
    "public/**"
  ],
  "plugins": [
    "typescript",
    "oxc",
    "react",
    "import"
  ],
  "jsPlugins": [
    {
      "name": "importx",
      "specifier": "eslint-plugin-import-x"
    },
    {
      "name": "tailwind",
      "specifier": "eslint-plugin-tailwindcss"
    },
    {
      "name": "boundaries",
      "specifier": "eslint-plugin-boundaries"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "settings": {
    "react": {
      "version": "18.2.0"
    },
    "import-x/resolver": {
      "typescript": {
        "project": [
          "tsconfig.json",
          "server/tsconfig.json"
        ],
        "alwaysTryTypes": true,
        "noWarnOnMultipleProjects": true
      },
      "node": {
        "extensions": [
          ".mjs",
          ".cjs",
          ".js",
          ".json",
          ".node",
          ".ts",
          ".tsx"
        ]
      }
    },
    "import/resolver": {
      "typescript": {
        "project": [
          "tsconfig.json",
          "server/tsconfig.json"
        ],
        "alwaysTryTypes": true,
        "noWarnOnMultipleProjects": true
      },
      "node": {
        "extensions": [
          ".mjs",
          ".cjs",
          ".js",
          ".json",
          ".node",
          ".ts",
          ".tsx"
        ]
      }
    },
    "boundaries/include": [
      "server/**/*.js",
      "server/**/*.ts",
      "src/modules/**/*.ts",
      "src/modules/**/*.tsx",
      "src/shared/*.ts",
      "src/shared/hooks/**/*.ts",
      "src/shared/hooks/**/*.tsx",
      "src/shared/context/**/*.ts",
      "src/shared/context/**/*.tsx",
      "src/shared/ui/**/*.ts",
      "src/shared/ui/**/*.tsx"
    ],
    "boundaries/elements": [
      {
        "type": "backend-shared-type-contract",
        "pattern": [
          "server/shared/types.{js,ts}",
          "server/shared/interfaces.{js,ts}"
        ],
        "mode": "file"
      },
      {
        "type": "backend-shared-utils",
        "pattern": [
          "server/shared/utils.{js,ts}",
          "server/shared/frontmatter.ts",
          "server/shared/claude-cli-path.ts",
          "server/shared/image-attachments.ts",
          "server/shared/message-unification.ts"
        ],
        "mode": "file"
      },
      {
        "type": "backend-module",
        "pattern": "server/modules/*",
        "mode": "folder",
        "capture": [
          "moduleName"
        ]
      },
      {
        "type": "frontend-shared-type-contract",
        "pattern": "src/shared/types.ts",
        "mode": "file"
      },
      {
        "type": "frontend-shared-file",
        "pattern": [
          "src/shared/utils.ts",
          "src/shared/constants.ts",
          "src/shared/api.ts",
          "src/shared/uiPreferences.ts",
          "src/shared/selectedProvider.ts",
          "src/shared/authToken.ts",
          "src/shared/voiceConfig.ts",
          "src/shared/codeEditorSettings.ts",
          "src/shared/userSettings.ts",
          "src/shared/chatDrafts.ts",
          "src/shared/syntaxHighlighter.ts",
          "src/shared/providerDisplay.ts"
        ],
        "mode": "file"
      },
      {
        "type": "frontend-shared-folder",
        "pattern": [
          "src/shared/hooks",
          "src/shared/context",
          "src/shared/ui"
        ],
        "mode": "folder"
      },
      {
        "type": "frontend-module",
        "pattern": "src/modules/*",
        "mode": "folder",
        "capture": [
          "moduleName"
        ]
      }
    ]
  },
  "rules": {
    "no-case-declarations": "off",
    "no-control-regex": "off",
    "no-useless-escape": "off",
    "typescript/no-explicit-any": "off",
    "typescript/no-require-imports": "off",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "react/static-components": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/immutability": "warn",
    "react/purity": "warn"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.jsx"
      ],
      "rules": {
        "no-unused-vars": [
          "warn",
          {
            "vars": "all",
            "varsIgnorePattern": "^_",
            "args": "after-used",
            "argsIgnorePattern": "^_",
            "caughtErrors": "none"
          }
        ],
        "react/jsx-key": "warn",
        "react/jsx-no-duplicate-props": "error",
        "react/jsx-no-undef": "error",
        "react/no-children-prop": "warn",
        "react/no-danger-with-children": "error",
        "react/no-direct-mutation-state": "error",
        "react/no-unknown-property": "warn",
        "react/react-in-jsx-scope": "off",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/only-export-components": [
          "warn",
          {
            "allowConstantExport": true
          }
        ],
        "import/no-duplicates": "warn",
        "importx/order": [
          "warn",
          {
            "groups": [
              "builtin",
              "external",
              "internal",
              "parent",
              "sibling",
              "index"
            ],
            "newlines-between": "always"
          }
        ],
        "tailwind/classnames-order": "warn",
        "tailwind/no-contradicting-classname": "warn",
        "tailwind/no-unnecessary-arbitrary-value": "warn"
      }
    },
    {
      "files": [
        "src/modules/**/*.ts",
        "src/modules/**/*.tsx",
        "src/shared/*.ts",
        "src/shared/hooks/**/*.ts",
        "src/shared/hooks/**/*.tsx",
        "src/shared/context/**/*.ts",
        "src/shared/context/**/*.tsx",
        "src/shared/ui/**/*.ts",
        "src/shared/ui/**/*.tsx",
        "src/shared/tests/**/*.ts",
        "src/shared/tests/**/*.tsx"
      ],
      "rules": {
        "typescript/consistent-type-definitions": [
          "error",
          "type"
        ],
        "typescript/consistent-type-imports": [
          "error",
          {
            "prefer": "type-imports",
            "fixStyle": "separate-type-imports"
          }
        ],
        "typescript/consistent-type-exports": [
          "error",
          {
            "fixMixedExportsWithInlineTypeSpecifier": true
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/",
                "message": "Use the @/ source-root alias for frontend application imports."
              }
            ]
          }
        ],
        "importx/no-unresolved": "error",
        "importx/no-useless-path-segments": "warn",
        "import/no-absolute-path": "error",
        "boundaries/dependencies": [
          "warn",
          {
            "default": "allow",
            "checkInternals": false,
            "rules": [
              {
                "from": {
                  "type": "frontend-module"
                },
                "to": {
                  "type": "frontend-shared-type-contract"
                },
                "disallow": {
                  "dependency": {
                    "kind": [
                      "value",
                      "typeof"
                    ]
                  }
                },
                "message": "Frontend modules may only use `import type` when importing from src/shared/types.ts."
              },
              {
                "to": {
                  "type": "frontend-module"
                },
                "disallow": {
                  "to": {
                    "internalPath": "**"
                  }
                },
                "message": "Cross-module imports must go through that module's barrel file (src/modules/<module>/index.ts)."
              },
              {
                "to": {
                  "type": "frontend-module"
                },
                "allow": {
                  "to": {
                    "internalPath": [
                      "index",
                      "index.{ts,tsx}"
                    ]
                  }
                }
              }
            ]
          }
        ],
        "boundaries/no-unknown": "warn"
      }
    },
    {
      "files": [
        "server/**/*.js",
        "server/**/*.ts"
      ],
      "excludeFiles": [
        "server/**/*.d.ts"
      ],
      "rules": {
        "no-unused-vars": "off",
        "no-async-promise-executor": "warn",
        "no-extra-boolean-cast": "warn",
        "no-unsafe-optional-chaining": "warn",
        "import/no-duplicates": "warn",
        "importx/order": [
          "warn",
          {
            "groups": [
              "builtin",
              "external",
              "internal",
              "parent",
              "sibling",
              "index"
            ],
            "newlines-between": "always"
          }
        ],
        "importx/no-unresolved": "error",
        "importx/no-useless-path-segments": "warn",
        "import/no-absolute-path": "error",
        "eqeqeq": [
          "warn",
          "always",
          {
            "null": "ignore"
          }
        ],
        "boundaries/dependencies": [
          "error",
          {
            "default": "allow",
            "checkInternals": false,
            "rules": [
              {
                "from": {
                  "type": "backend-module"
                },
                "to": {
                  "type": "backend-shared-type-contract"
                },
                "disallow": {
                  "dependency": {
                    "kind": [
                      "value",
                      "typeof"
                    ]
                  }
                },
                "message": "Backend modules may only use `import type` when importing from server/shared/types.ts or server/shared/interfaces.ts."
              },
              {
                "to": {
                  "type": "backend-module"
                },
                "disallow": {
                  "to": {
                    "internalPath": "**"
                  }
                },
                "message": "Cross-module imports must go through that module's barrel file (server/modules/<module>/index.ts or index.js)."
              },
              {
                "to": {
                  "type": "backend-module"
                },
                "allow": {
                  "to": {
                    "internalPath": [
                      "index",
                      "index.{js,mjs,cjs,ts,tsx}"
                    ]
                  }
                }
              }
            ]
          }
        ],
        "boundaries/no-unknown": "error"
      }
    }
  ]
}